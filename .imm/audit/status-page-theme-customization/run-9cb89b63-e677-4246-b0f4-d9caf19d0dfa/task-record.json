          "evidence": {
            "trigger": "Remove the three theme_config equality clauses from hasMatchingStatusPublicSettings or hasMatchingHomepagePublicSettings → if the fake D1 row or runtimeSnapshot fails any other guard precondition, the test still gets null and stays green, so it may not catch the regression",
            "caller_chain": [
