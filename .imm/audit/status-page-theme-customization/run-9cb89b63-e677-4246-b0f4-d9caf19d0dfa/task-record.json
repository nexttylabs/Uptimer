          "evidence": {
            "trigger": "Change useApplyStatusPageCustomCss to skip cleanup on a slug change, or change syncStatusPageCustomCss to set innerHTML → the statusPageCustomCss.test.ts assertions still pass because the hook is never run and the fake element has no innerHTML setter",
            "caller_chain": [
